# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Postgres connection strings (Supabase dashboard > Connect > Direct).
# Percent-encode special characters in the password (for example # becomes %23).
# Transaction pooler, port 6543: used by the app at runtime.
DATABASE_URL=
# Session pooler, port 5432: used by drizzle-kit migrations and the seed script.
DATABASE_URL_DIRECT=

# Optional: email to register as the owner admin when running npm run db:seed.
ADMIN_SEED_EMAIL=

# Development only: true publishes the seeded sample products, false hides them.
# Remove or set false before launch.
SEED_SAMPLES_ACTIVE=

# Public site origin for canonical URLs, sitemap, robots and structured data.
# Example: https://shasroy.com (no trailing slash). Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Secret for the abandoned-cart cleanup endpoint. Send as "Authorization: Bearer <value>".
# Leave empty in development to disable the endpoint.
CRON_SECRET=
